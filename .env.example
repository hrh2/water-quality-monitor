# Copy this file to .env (local dev) and fill in real values.
# NEVER commit a real .env file. See docs/deployment/vercel.md and
# docs/backend/authentication.md for full setup instructions.

# PostgreSQL connection string. Works with Neon, Supabase, Vercel Postgres,
# or any standard Postgres provider - use the provider's POOLED connection
# string if one is offered (see docs/database/setup.md).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Secret used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Default development admin account, used only by scripts/seed_admin.js.
# The seeded account is forced to change its password on first login
# (must_change_password). Never reuse this password anywhere real.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-dev-password
